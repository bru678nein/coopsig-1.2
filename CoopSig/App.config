<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <appSettings>
    <!--
      Ruta al archivo de base de datos Access (.mdb) de ESTA instalación.
      Existen dos instalaciones independientes con bases separadas
      (Constitución VIII): el ejecutable es idéntico en ambas; esta ruta
      es lo único que debe cambiar entre una oficina y la otra.
    -->
    <add key="RutaBaseDatos" value="C:\CoopSig\Datos\base.mdb" />

    <!-- Carpeta donde se guardan las copias de seguridad automáticas (Constitución VII). -->
    <add key="CarpetaBackups" value="C:\CoopSig\Backups" />

    <!--
      Carpeta con las imágenes del recibo: el escudo de la cooperativa
      (coopsig) y las firmas escaneadas de las autoridades (presidente,
      secretario, tesorero). Se aceptan png, jpg o bmp. Si falta alguna, el
      recibo sale igual: sin escudo, o con la línea vacía para firmar a mano.
      Por defecto: subcarpeta "Firmas" junto al ejecutable.

      Estos archivos NO están en el repositorio y no deben estarlo: una firma
      escaneada es el instrumento para firmar en nombre de esa persona.
    -->
    <add key="CarpetaFirmas" value="" />

    <!-- Cantidad de copias de seguridad a conservar; las más antiguas se descartan. -->
    <add key="CantidadBackupsAConservar" value="30" />
  </appSettings>
</configuration>
