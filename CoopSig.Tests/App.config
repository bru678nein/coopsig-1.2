<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <appSettings>
    <!--
      Base de datos usada SOLO por las pruebas de integración de
      AsociadoRepositoryTests. Debe ser una copia, nunca la base original
      (Constitución I). Ver TestData/LEEME.txt.
    -->
    <add key="RutaBaseDatos" value="TestData\base_test.mdb" />
    <add key="CarpetaBackups" value="TestData\Backups" />
    <add key="CantidadBackupsAConservar" value="30" />
  </appSettings>
</configuration>
